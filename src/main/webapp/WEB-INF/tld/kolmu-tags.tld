<?xml version="1.0" encoding="utf-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
	version="3.0">
	<description>FAQ Tags Library</description>
	<display-name>FAQ tags</display-name>
	<tlib-version>1.0</tlib-version>
	<short-name>faq</short-name>
	<uri>http://kommet.io</uri>
	<tag>
		<description>User package tag</description>
		<name>userPackage</name>
		<tag-class>kommet.basic.keetle.tags.UserPackageTag</tag-class>
		<body-content>empty</body-content>
		<attribute>
			<name>package</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<description>Render i18n label tag</description>
		<name>label</name>
		<tag-class>kommet.basic.keetle.tags.LabelTag</tag-class>
		<body-content>scriptless</body-content>
		<attribute>
			<name>i18n</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>key</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<description>Action messages</description>
		<name>messages</name>
		<tag-class>kommet.web.tags.ActionMessages</tag-class>
		<body-content>empty</body-content>
		<attribute>
			<name>cssClass</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>messages</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<description>Login Panel</description>
		<name>login-panel</name>
		<tag-class>kommet.web.tags.LoginPanel</tag-class>
		<body-content>empty</body-content>
		<attribute>
			<name>cssClass</name>
			<required>false</required>
		</attribute>
		<attribute>
			<name>action</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<description>Action messages</description>
		<name>errors</name>
		<tag-class>kommet.web.tags.ActionErrors</tag-class>
		<body-content>empty</body-content>
		<attribute>
			<name>cssClass</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>messages</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
</taglib>