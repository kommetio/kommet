<?xml version="1.0" encoding="utf-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
	version="3.0">
	<description>Kommet auth tag library</description>
	<display-name>Kommet auth tags</display-name>
	<tlib-version>1.0</tlib-version>
	<short-name>kommet-auth</short-name>
	<uri>http://kommet.io</uri>
	<tag>
		<description>Check type access</description>
		<name>checkTypeAccess</name>
		<tag-class>kommet.auth.tags.CheckTypeAccessTag</tag-class>
		<body-content>scriptless</body-content>
		<attribute>
			<name>typeId</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>access</name>
			<required>true</required>
			<rtexprvalue>false</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<description>Check access</description>
		<name>check</name>
		<tag-class>kommet.auth.tags.CheckAccessTag</tag-class>
		<body-content>scriptless</body-content>
		<attribute>
			<name>profile</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
</taglib>